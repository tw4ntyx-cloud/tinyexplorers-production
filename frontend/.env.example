# Copy this file to .env for local development (optional — the defaults work).
# Deployed builds set these at build time instead (see .env.production and the
# deploy workflow); a deployed build without REACT_APP_BACKEND_URL cannot reach
# the API.

# Leave empty for local development: the dev server proxies /api to the local
# backend (src/setupProxy.js), so no CORS configuration is needed. Set it only
# to point a dev build at a different API.
REACT_APP_BACKEND_URL=

# Public Google Calendar appointment schedule for nursery tours.
# This is not a secret; Google Calendar remains the source of truth for
# availability, confirmations, reminders, and booking conflicts.
REACT_APP_TOUR_BOOKING_URL=https://calendar.app.google/PKmUZbas6Hyo397WA

# Canonical site URL for canonical/OG tags and structured data. Defaults to
# the current GitHub Pages staging origin if unset. At launch, set this to
# https://tinyexplorersbda.com — no source changes required.
REACT_APP_WEBSITE_URL=https://tw4ntyx-cloud.github.io
