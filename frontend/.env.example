# Copy this file to .env (local dev) and set real values in your hosting
# provider's dashboard (e.g. Vercel Project Settings → Environment Variables)
# for deployed environments. Without this, all form submissions will fail
# because the frontend won't know where the backend API lives.

REACT_APP_BACKEND_URL=http://localhost:8000

# Canonical site URL for canonical/OG tags and structured data. Defaults to
# the current GitHub Pages staging origin if unset. At launch, set this to
# https://tinyexplorersbda.com — no source changes required.
REACT_APP_WEBSITE_URL=https://tw4ntyx-cloud.github.io
