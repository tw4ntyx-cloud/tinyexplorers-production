{
  // One-click private preview in GitHub Codespaces (development only).
  // Opens the site on a PRIVATE forwarded port (only your GitHub account can
  // see it). Runs in safe preview mode: in-memory database, no email sending.
  "name": "Tiny Explorers — safe preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt && cd frontend && npm ci",
  "postAttachCommand": { "preview": ".devcontainer/start-preview.sh" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Tiny Explorers website", "onAutoForward": "openBrowser" },
    "8000": { "label": "Local API (reached via the website's /api proxy)", "onAutoForward": "ignore" }
  },
  "containerEnv": { "BROWSER": "none" }
}
