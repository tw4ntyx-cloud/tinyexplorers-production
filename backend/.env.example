# Backend Configuration for Tiny Explorers API
# Copy this file to .env and update with your values.
# For local development, empty MONGO_URL will enable a safe in-memory fallback.

# ===== MongoDB Configuration =====
# Leave MONGO_URL blank if you do not have a MongoDB instance available locally.
MONGO_URL=
DB_NAME=tiny_explorers

# ===== Email Service Configuration (Resend) =====
# Sign up at https://resend.com to get your API key.
RESEND_API_KEY=
ADMIN_EMAIL=admissions@tinyexplorers.bm
FROM_EMAIL=enrollment@tinyexplorers.bm

# ===== Admin Access =====
# Required to read GET /api/newsletter, /api/enrollment, /api/inquiry,
# /api/admissions (they return family PII). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as the X-Admin-Key header. Leave blank to deny all admin GET access.
ADMIN_API_KEY=

# ===== CORS Configuration =====
# List of origins allowed to access the API (comma-separated).
# Set this to the real frontend origin(s) for each environment — e.g. a
# temporary preview URL during development, and the production domain once
# it is connected. Never leave this as "*" in production.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# ===== Google Workspace Newsletter Group (Admin SDK) =====
# GOOGLE_WORKSPACE_ADMIN_EMAIL and GOOGLE_NEWSLETTER_GROUP_EMAIL are always
# required. In addition, set EITHER (not both) of the two auth modes below.
# If neither is set, subscribers are stored with status "pending" and can be
# retried later via POST /api/admin/newsletter/sync once configured.
# See docs/google-workspace-newsletter.md for the full setup guide.

# --- Auth mode 1: KEYLESS (recommended for production, no private key ever
# created/stored). Requires running on infrastructure that provides Google
# Application Default Credentials (e.g. Cloud Run/GCE/GKE with an attached
# service account, or `gcloud auth application-default login` locally).
# This is the only supported mode if your Google Cloud org enforces
# `iam.managed.disableServiceAccountKeyCreation` — do not disable that policy.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# --- Auth mode 2: SERVICE_ACCOUNT_JSON (legacy/local only). A downloaded
# service-account JSON key, single line. Only usable where key creation is
# permitted. If both this and GOOGLE_SERVICE_ACCOUNT_EMAIL are set, this one
# takes precedence.
GOOGLE_SERVICE_ACCOUNT_JSON=

# A real Workspace admin user the service account impersonates (domain-wide
# delegation requires acting as a real admin) — required for both modes.
GOOGLE_WORKSPACE_ADMIN_EMAIL=
# The newsletter distribution group to add subscribers to.
GOOGLE_NEWSLETTER_GROUP_EMAIL=newsletter@tinyexplorersbda.com

# ===== Server Configuration =====
ENVIRONMENT=development
LOG_LEVEL=INFO
